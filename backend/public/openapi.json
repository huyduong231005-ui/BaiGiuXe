{
 "openapi": "3.0.3",
 "info": {
  "title": "Bãi giữ xe API",
  "version": "1.0.0",
  "description": "REST API cho app Flutter quản lý bãi giữ xe. Đăng nhập: /auth/login → mã OTP gửi email → /auth/login/verify trả JWT; bấm Authorize và dán JWT."
 },
 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer",
    "bearerFormat": "JWT"
   }
  }
 },
 "security": [
  {
   "bearer": []
  }
 ],
 "paths": {
  "/auth/register": {
   "post": {
    "tags": [
     "Xác thực"
    ],
    "summary": "Đăng ký, gửi OTP",
    "security": [],
    "requestBody": {
     "content": {
      "application/json": {
       "example": {
        "email": "ban@gmail.com",
        "username": "baove1",
        "fullName": "Lê Văn B",
        "password": "matkhau1"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "OK"
     },
     "400": {
      "description": "Dữ liệu không hợp lệ"
     },
     "401": {
      "description": "Chưa đăng nhập"
     }
    }
   }
  },
  "/auth/register/verify": {
   "post": {
    "tags": [
     "Xác thực"
    ],
    "summary": "Xác minh OTP đăng ký → JWT",
    "security": [],
    "requestBody": {
     "content": {
      "application/json": {
       "example": {
        "email": "ban@gmail.com",
        "code": "123456"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "OK"
     },
     "400": {
      "description": "Dữ liệu không hợp lệ"
     },
     "401": {
      "description": "Chưa đăng nhập"
     }
    }
   }
  },
  "/auth/login": {
   "post": {
    "tags": [
     "Xác thực"
    ],
    "summary": "Mật khẩu đúng → gửi OTP",
    "security": [],
    "requestBody": {
     "content": {
      "application/json": {
       "example": {
        "username": "baove1",
        "password": "matkhau1"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "OK"
     },
     "400": {
      "description": "Dữ liệu không hợp lệ"
     },
     "401": {
      "description": "Chưa đăng nhập"
     }
    }
   }
  },
  "/auth/login/verify": {
   "post": {
    "tags": [
     "Xác thực"
    ],
    "summary": "Xác minh OTP đăng nhập → JWT",
    "security": [],
    "requestBody": {
     "content": {
      "application/json": {
       "example": {
        "username": "baove1",
        "code": "123456"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "OK"
     },
     "400": {
      "description": "Dữ liệu không hợp lệ"
     },
     "401": {
      "description": "Chưa đăng nhập"
     }
    }
   }
  },
  "/auth/google": {
   "post": {
    "tags": [
     "Xác thực"
    ],
    "summary": "Đăng nhập Google (idToken) → JWT",
