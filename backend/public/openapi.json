  "/sessions": {
   "get": {
    "tags": [
     "Bãi xe"
    ],
    "summary": "Lượt gửi theo ngày / xe trong bãi, kèm doanh thu",
    "parameters": [
     {
      "name": "date",
      "in": "query",
      "required": false,
      "description": "Ngày YYYY-MM-DD (mặc định hôm nay)",
      "example": "2026-10-30",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "plate",
      "in": "query",
      "required": false,
      "description": "Tìm biển (vào hoặc ra)",
      "example": "59X1",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "open",
      "in": "query",
      "required": false,
      "description": "true = xe đang trong bãi",
      "example": "false",
      "schema": {
       "type": "string"
      }
