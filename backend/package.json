{
  "name": "bai-giu-xe-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API cho app quản lý bãi giữ xe (Flutter + ESP32), dữ liệu trên Supabase Postgres",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "make-admin": "node --env-file-if-exists=.env src/make-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "google-auth-library": "^11.3.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13"
  }
}
