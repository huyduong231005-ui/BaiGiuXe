# Chép thành .env để chạy thử trên máy (npm run dev). .env không đưa lên git.
TZ=Asia/Ho_Chi_Minh
JWT_SECRET=chuoi-bi-mat-dai
# Supabase -> Connect -> Session pooler (dạng postgresql://postgres.<ref>:<mật khẩu>@aws-0-<vùng>.pooler.supabase.com:5432/postgres)
DATABASE_URL=
SUPABASE_URL=https://<ref>.supabase.co
# Project Settings -> API Keys -> khoá secret (service_role). Chỉ để ở máy chủ, không đưa vào app.
SUPABASE_SERVICE_KEY=
PLATE_TOKEN=
GOOGLE_CLIENT_ID=
BREVO_API_KEY=
MAIL_FROM=
